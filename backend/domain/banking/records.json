  "retrieval_triggers": [
    {
      "id": "fraud_flag_routing",
      "field": "fraud_flag",
      "op": "truthy",
      "query": "fraud engine flag mandatory routing to fraud operations dispute intake",
      "why": "C3: the flag exists only in the transaction record, so nothing in the user's words can pull the routing rule into context."
    },
    {
      "id": "signature_tier_timing",
      "field": "product_tier",
      "op": "equals",
      "value": "SIGNATURE",
      "query": "accelerated provisional credit timing for Signature premium cardholders",
      "why": "C1: the product tier is a record fact, not something the cardholder states."
    },
    {
      "id": "small_amount_goodwill",
      "field": "amount",
      "op": "lt",
      "value": 50,
      "query": "goodwill refund auto approval threshold and merchant contact requirement",
      "why": "C2: whether the goodwill route is even available turns on the posted amount."
    },
    {
      "id": "high_risk_merchant",
      "field": "risk_band",
      "op": "equals",
      "value": "high",
      "query": "merchant dispute history and chargeback representment evidence requirements",
      "why": "Merchant risk is a graph/record property the cardholder cannot report."
    }
  ]
