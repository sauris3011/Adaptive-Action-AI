# ---------------------------------------------------------------------------
# Adaptive Knowledge-to-Action Copilot - environment template
# Copy to .env at the repo root and fill in. .env is gitignored.
# ---------------------------------------------------------------------------

# --- LiteLLM gateway (required) ---
# LangChain talks to this proxy using the OpenAI wire format.
GATEWAY_URL=http://localhost:4000
GATEWAY_API_KEY=

# --- Model aliases (leave unset) ---
# Model routing is chosen in the UI: open Settings, press "Probe gateway" and
# pick a model per role from the live GET {GATEWAY_URL}/v1/models catalogue.
# Nothing is pre-selected on first boot. These are an escape hatch for
# unattended runs only - set them and the drawer starts pre-filled.
# MODEL_TRIAGE=
# MODEL_DIGEST=
# MODEL_REASON=
# MODEL_EMBED=

# --- TLS ---
# false disables certificate verification for the corporate MITM proxy.
# SECURITY: with this off the app cannot distinguish the corporate proxy from
# a hostile man-in-the-middle. Prototype/synthetic data only. See PRD 7.2.
SSL_VERIFY=true

# --- Server ---
HOST=127.0.0.1
PORT=8787

# --- Knowledge graph ---
# Leave NEO4J_URI blank to force the embedded Kuzu fallback.
# GRAPH_BACKEND: auto | neo4j | kuzu
GRAPH_BACKEND=auto
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Observability (optional, fire-and-forget, never blocks a request) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=adaptive-action-copilot
